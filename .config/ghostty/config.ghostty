# --- Appearance ---
window-theme = system
# Daily driver type themes
# theme = Doom Peacock
# theme = Adwaita Dark
theme = Gruvbox Dark
# theme = Material Dark
# theme = Chalk

# Bit weird but otherwise ok
# theme = Firefox Dev
# theme = Dimmed Monokai

# FuNkY colour themes
# theme = IC Orange PPL

# Retro terminal themes
# theme = HaX0R Gr33N
# theme = iTerm2 Smoooooth
# theme = ENCOM
# theme = CGA
# theme = Konsolas
# theme = IRIX Console

# Fonts
font-size = 12
font-family = "monospace"
adjust-cell-height = 5%

# Background
background-opacity = 0.90
background-blur = true

# --- Cursor ---
# Blinking solid block as requested
cursor-style = block
cursor-style-blink = true
cursor-click-to-move = true
shell-integration-features = no-cursor

# --- Window Layout ---
background-blur-radius = 20
window-width = 118
window-height = 34
window-padding-x = 4
window-padding-y = 4
window-decoration = true

# --- Behaviors ---
confirm-close-surface = true
notify-on-command-finish = unfocused

# --- Keybinds ---
keybind = ctrl+shift+r=reload_config
keybind = f11=toggle_fullscreen

# --- Scrollback ---
# In bytes
scrollback-limit = 10000000

# --- Working dir ---
working-directory = home
