# --- Appearance ---
# theme = dark

font-size = 12
font-family = "monospace"

# --- Cursor ---
# Blinking solid block as requested
cursor-style = block
cursor-style-blink = true
cursor-click-to-move = true

# --- Window Layout ---
background-blur-radius = 20
window-width = 122
window-height = 28
window-padding-x = 6
window-padding-y = 6
window-decoration = true

# --- Behaviors ---
# copy-on-select = true
confirm-close-surface = true

# --- Keybinds ---
keybind = ctrl+shift+r=reload_config

# --- Scrollback ---

# Additional visual settings
# term = xterm-256color
